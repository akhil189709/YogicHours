# Application
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000
NODE_ENV=development

# Google Sheets — the Booking and Contact forms post straight from the browser to a Google Apps
# Script web app (google-apps-script/Code.gs). Deploy that script as a Web app and paste its URL
# here; it looks like https://script.google.com/macros/s/AKfycb.../exec
# NEXT_PUBLIC_ means the browser can read it (visitors can see the URL — the script validates
# everything itself). Restart the dev server / rebuild after changing it.
NEXT_GOOGLE_SHEETS_URL=

# Email Service
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# WhatsApp Integration (Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Social Media
INSTAGRAM_HANDLE=https://www.instagram.com/yogichours?utm_source=qr&stkn=YmR2ZDY3ODZ3MTkw
FACEBOOK_PAGE=
YOUTUBE_CHANNEL=https://www.youtube.com/@YogicHours26
LINKEDIN_PROFILE=Yogic Hours

# Feature Flags
ENABLE_EMAIL_NOTIFICATIONS=true
